# Database PostgreSQL usato da MMC.
MMC_DB_HOST=postgres
MMC_DB_PORT=5432
MMC_DB_NAME=my_media_collection
MMC_DB_USER=
MMC_DB_PASSWORD=

# Secret key Flask per sessioni e form.
MMC_SECRET_KEY=change-me

# Eseguibile e parametri base usati dal resolver FileBot.
FILEBOT_PATH=filebot
FILEBOT_LANG=it
FILEBOT_TIMEOUT=20

# Cache locale dei risultati FileBot.
FILEBOT_CACHE_TTL_SECONDS=604800
FILEBOT_EMPTY_CACHE_TTL_SECONDS=60
FILEBOT_CACHE_MAX=1000

# Path host e path container della licenza FileBot.
# `FILEBOT_LICENSE_DIR` viene usata anche dal docker-compose per il bind mount.
FILEBOT_LICENSE_DIR=
FILEBOT_LICENSE_FILE=/licenses/FileBot_License.psm

# Browser remoto condiviso usato da DDU e MirCrew via CDP.
BROWSER_CDP_URL=http://chromium-ddu:9223
BROWSER_LOGIN_URL=https://192.168.1.161:3021
BROWSER_TIMEOUT_SECONDS=45

# Override legacy ancora supportati dal codice per compatibilita con il vecchio setup DDU.
# Se valorizzi BROWSER_* normalmente non servono.
#DDU_BROWSER_CDP_URL=http://chromium-ddu:9223
#DDU_BROWSER_LOGIN_URL=https://192.168.1.161:3021
#DDU_BROWSER_TIMEOUT_SECONDS=45

# Base URL dei siti sorgente.
DDU_BASE_URL=https://ddunlimited.net
MIRCREW_BASE_URL=https://mircrew-releases.org

# Cache detail in RAM MirCrew e limiti scan liste.
# MIRCREW_REFRESH_MAX_PAGES, MIRCREW_REFRESH_JUMP_PAGES e MIRCREW_REFRESH_FLUSH_PAGES
# sono override operativi, non obbligatori.
#MIRCREW_DETAIL_CACHE_TTL_SECONDS=86400
#MIRCREW_REFRESH_MAX_PAGES=500
#MIRCREW_REFRESH_JUMP_PAGES=15
#MIRCREW_REFRESH_FLUSH_PAGES=15

# Altri service settings come Radarr, Sonarr e Plex Web
# sono oggi salvati nel database/settings dell'app.
